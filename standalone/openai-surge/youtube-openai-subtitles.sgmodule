#!name=YouTube OpenAI 字幕翻译
#!desc=使用 BoxJs 配置的 OpenAI 兼容 API 生成 YouTube 双语字幕
#!openUrl=http://boxjs.com/#/app/YouTubeOpenAI
#!author=lostornot
#!homepage=https://github.com/lostornot/YouTube/tree/agent/independent-openai-surge/standalone/openai-surge

[Script]
YouTube OpenAI subtitles request = type=http-request, pattern=^https?:\/\/([\w-]+\.)?youtube\.com\/api\/timedtext, timeout=30, script-path=https://raw.githubusercontent.com/lostornot/YouTube/30fcc4498b34d51afe0447a5c08e325f18b9fbd2/standalone/openai-surge/youtube-openai-request.js
YouTube OpenAI subtitles response = type=http-response, pattern=^https?:\/\/([\w-]+\.)?youtube\.com\/api\/timedtext, requires-body=1, max-size=0, timeout=60, script-path=https://raw.githubusercontent.com/lostornot/YouTube/30fcc4498b34d51afe0447a5c08e325f18b9fbd2/standalone/openai-surge/youtube-openai-subtitles.js

[MITM]
hostname = %APPEND% *.youtube.com
