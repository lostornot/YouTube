#!name=YouTube OpenAI-compatible subtitles
#!desc=YouTube bilingual subtitles through an OpenAI-compatible API configured in BoxJs.
#!system=ios,macos

[Script]
YouTube OpenAI subtitles request = type=http-request,pattern=^https?:\\/\\/(www|m)\\.youtube\\.com\\/api\\/timedtext,script-path=https://raw.githubusercontent.com/lostornot/YouTube/agent/independent-openai-surge/standalone/openai-surge/youtube-openai-request.js
YouTube OpenAI subtitles response = type=http-response,pattern=^https?:\\/\\/(www|m)\\.youtube\\.com\\/api\\/timedtext\\?.*fmt=json3,requires-body=1,script-path=https://raw.githubusercontent.com/lostornot/YouTube/agent/independent-openai-surge/standalone/openai-surge/youtube-openai-subtitles.js

[MITM]
hostname = %APPEND% www.youtube.com, m.youtube.com
