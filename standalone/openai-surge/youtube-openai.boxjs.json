{
  "id": "YouTubeOpenAI.sub",
  "name": "YouTube OpenAI 字幕翻译",
  "author": "@lostornot",
  "description": "使用 OpenAI 兼容 API 翻译 YouTube 字幕",
  "repo": "https://github.com/lostornot/YouTube/tree/agent/independent-openai-surge/standalone/openai-surge",
  "apps": [
    {
      "id": "YouTubeOpenAI",
      "name": "YouTube OpenAI 字幕翻译",
      "descs_html": [
        "填写完成后请点击页面底部的保存按钮。API 凭证只保存在当前设备的 BoxJs 数据中。"
      ],
      "keys": ["@YouTubeOpenAI.Settings"],
      "settings": [
        { "id": "@YouTubeOpenAI.Settings.Enabled", "name": "启用翻译", "type": "boolean", "val": true, "desc": "关闭后不修改字幕。" },
        { "id": "@YouTubeOpenAI.Settings.Endpoint", "name": "OpenAI 兼容 API URL", "type": "text", "val": "", "placeholder": "https://api.example.com/v1/chat/completions", "desc": "可填写 Base URL，也可填写完整的 /chat/completions 地址。" },
        { "id": "@YouTubeOpenAI.Settings.APIKey", "name": "API Key", "type": "text", "val": "", "placeholder": "sk-...", "desc": "仅保存在当前设备，请勿提交到公开仓库。" },
        { "id": "@YouTubeOpenAI.Settings.Model", "name": "模型", "type": "text", "val": "", "placeholder": "deepseek-v4-flash", "desc": "填写服务商支持的 Chat Completions 模型名。" },
        { "id": "@YouTubeOpenAI.Settings.TargetLanguage", "name": "目标语言", "type": "selects", "val": "zh-Hans", "items": [ { "key": "zh-Hans", "label": "中文（简体）" }, { "key": "zh-Hant", "label": "中文（繁体）" }, { "key": "en", "label": "English" }, { "key": "ja", "label": "日本語" }, { "key": "ko", "label": "한국어" }, { "key": "es", "label": "Español" }, { "key": "fr", "label": "Français" }, { "key": "de", "label": "Deutsch" } ], "desc": "翻译输出语言。" },
        { "id": "@YouTubeOpenAI.Settings.SourceLanguage", "name": "源语言", "type": "selects", "val": "auto", "items": [ { "key": "auto", "label": "自动识别" }, { "key": "en", "label": "English" }, { "key": "ja", "label": "日本語" }, { "key": "ko", "label": "한국어" }, { "key": "zh-Hans", "label": "中文（简体）" }, { "key": "zh-Hant", "label": "中文（繁体）" } ] },
        { "id": "@YouTubeOpenAI.Settings.ShowOnly", "name": "只显示译文", "type": "boolean", "val": false, "desc": "关闭时显示原文和译文两行。" }
      ],
      "author": "@lostornot",
      "repo": "https://github.com/lostornot/YouTube/tree/agent/independent-openai-surge/standalone/openai-surge"
    }
  ]
}
